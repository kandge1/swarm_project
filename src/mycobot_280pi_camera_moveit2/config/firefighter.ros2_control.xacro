<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="firefighter_ros2_control" params="name initial_positions_file hardware_mode:=mock">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- hardware_mode selects exactly one of: mock (RViz-only),
                     gazebo (Gazebo Harmonic sim), real (physical mycobot 280
                     Pi hardware). Same URDF/ros2_control joint list serves
                     all three; only the plugin underneath differs. -->
                <xacro:if value="${hardware_mode == 'gazebo'}">
                    <!-- Gazebo Harmonic physics-coupled hardware interface -->
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${hardware_mode == 'real'}">
                    <!-- Physical mycobot 280 Pi hardware interface -->
                    <plugin>mycobot_hardware/MyCobotSystem</plugin>
                </xacro:if>
                <xacro:if value="${hardware_mode == 'mock'}">
                    <!-- Mock hardware for RViz-only mode -->
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
            </hardware>
            <joint name="joint2_to_joint1">
                <command_interface name="position">
                  <param name="initial_value">${initial_positions['joint2_to_joint1']}</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint2_to_joint1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint3_to_joint2">
                <command_interface name="position">
                  <param name="initial_value">${initial_positions['joint3_to_joint2']}</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint3_to_joint2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint4_to_joint3">
                <command_interface name="position">
                  <param name="initial_value">${initial_positions['joint4_to_joint3']}</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint4_to_joint3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint5_to_joint4">
                <command_interface name="position">
                  <param name="initial_value">${initial_positions['joint5_to_joint4']}</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint5_to_joint4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint6_to_joint5">
                <command_interface name="position">
                  <param name="initial_value">${initial_positions['joint6_to_joint5']}</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint6_to_joint5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint6output_to_joint6">
                <command_interface name="position">
                  <param name="initial_value">${initial_positions['joint6output_to_joint6']}</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint6output_to_joint6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_controller">
                <command_interface name="position">
                  <param name="initial_value">0.0</param>
                </command_interface>
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <!-- Exposes gz_ros2_control's simulated joint effort on
                     /joint_states for gripper_controller, so pick_place.py
                     can stop closing on contact instead of always driving
                     to a fixed closed position regardless of what's in the
                     gripper. -->
                <state_interface name="effort"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
