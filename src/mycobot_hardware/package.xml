<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mycobot_hardware</name>
  <version>0.0.0</version>
  <description>
    ros2_control SystemInterface plugin (mycobot_hardware/MyCobotSystem) for
    the physical mycobot 280 Pi. Bridges to pymycobot (Python, vendor driver)
    over a Unix domain socket rather than reimplementing the serial protocol
    in C++ -- see scripts/mycobot_bridge.py and mycobot_system.cpp for why.
  </description>
  <maintainer email="rhishi.kandge@gmail.com">Rhishi Kandge</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- scripts/mycobot_bridge.py needs pymycobot, installed via pip
       (pi_setup/requirements.txt), not an apt/rosdep package, so it is
       not declared as an exec_depend here. -->

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/mycobot_hardware.xml" />
  </export>
</package>
