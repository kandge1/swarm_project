<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS>
  <Domain>
    <General>
      <!-- For the robot (Galactic, Cyclone DDS 0.22.6) ONLY -- mars
           (Jazzy, newer Cyclone DDS) uses cyclonedds_jazzy.xml instead.

           spdp, not false, and NO 127.0.0.1 peer: unlike Jazzy's Cyclone
           DDS, adding 127.0.0.1 as an explicit static peer on this older
           Galactic build made same-host discovery WORSE, not better --
           confirmed: controller spawners went from occasionally succeeding
           to failing 100% of the time (5/5 retries) with "empty node name
           returned by the RMW layer" once 127.0.0.1 was added. Likely this
           version's peer-discovery code doesn't handle a self-referential
           unicast peer cleanly. spdp (permit multicast for SPDP discovery
           only, never for data) is the best known option here: it isn't
           fully reliable for same-host discovery either (this Galactic
           Cyclone DDS build has a documented, unfixed upstream discovery-
           timing race -- see the retrying_spawner wrapper in
           real_robot_hardware.launch.py, which is the actual mitigation),
           but it's strictly better than 127.0.0.1 here. Cross-host
           discovery (mars<->robot) still goes through the static Peers
           list below regardless -- the campus Wi-Fi blocks multicast for
           that regardless of this setting. -->
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <Peers>
        <Peer address="172.30.6.165"/>
        <Peer address="172.27.89.157"/>
      </Peers>
    </Discovery>
    <Internal>
      <!-- Confirmed on real hardware (2026-07-26): small trajectories (2-3
           waypoints, ~1KB serialized) always deliver fine; a 30-waypoint
           pre-grasp trajectory (~9KB serialized) never arrives at all,
           and robot_state_publisher/ros2_control_node both immediately
           start logging repeated serdata.cpp:354 "invalid data size" /
           "string data is not null-terminated" errors right after -- on
           EVERY subsequent sample, not just the one that failed. Cyclone
           DDS's default FragmentSize (~1456B, one Ethernet MTU) means the
           small trajectories never fragment but the large one needs
           several fragments reassembled over a lossy/high-latency Wi-Fi
           unicast link -- Galactic's Cyclone DDS (0.22.6) is the older,
           less-patched build on this link, and reassembly-related
           deserialization bugs in old builds are a known category of
           issue there. Raising both limits well above anything this
           project will ever send avoids fragmentation entirely instead
           of trying to make reassembly reliable. Must match the value in
           cyclonedds_jazzy.xml -- FragmentSize/MaxMessageSize are
           effectively a wire-compatible pair between both ends of a
           connection. -->
      <FragmentSize>65500B</FragmentSize>
      <MaxMessageSize>65500B</MaxMessageSize>
    </Internal>
  </Domain>
</CycloneDDS>
