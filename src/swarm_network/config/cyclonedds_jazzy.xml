<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS>
  <Domain>
    <General>
      <!-- For mars (Jazzy, newer Cyclone DDS) ONLY - the robot (Galactic,
           Cyclone DDS 0.22.6) uses cyclonedds_galactic.xml instead, see that
           file's comment for why they can't share one config.

           false, not spdp: AllowMulticast=spdp still depends on multicast
           actually working for SPDP announcements, including on loopback -
           and on this campus Wi-Fi that turned out to be unreliable even
           for same-host discovery (confirmed: a fresh `ros2 node list` on
           mars could not see mars's own already-running move_group with
           spdp set). Disabling multicast entirely and explicitly listing
           127.0.0.1 as a peer forces ALL discovery - same-host and
           cross-host alike - through the same static unicast mechanism,
           so it no longer depends on multicast working anywhere, ever.
           Confirmed working on mars: ros2 node list immediately showed
           move_group/rviz after this change. -->
      <AllowMulticast>false</AllowMulticast>

      <!-- KEEP EVERY UDP DATAGRAM UNDER THE ETHERNET MTU (2026-07-26).
           Must be kept numerically in step with cyclonedds_galactic.xml,
           since these govern the wire format and both ends of the link
           have to agree. See that file for the measured evidence. In
           short: on this link, any RTPS message needing IP level
           fragmentation is never delivered, and capping datagrams under
           the MTU is what fixes it. Do not raise these values.

           NOTE the location differs by distro, which is why it is fine
           for these two files to disagree structurally: on Jazzy's newer
           Cyclone these live under General, and putting them under
           Internal logs "setting moved to //CycloneDDS/Domain/General/...".
           On the robot's Cyclone 0.22.6 they are still under Internal. -->
      <MaxMessageSize>1400B</MaxMessageSize>
      <FragmentSize>1300B</FragmentSize>
    </General>
    <Discovery>
      <Peers>
        <Peer address="127.0.0.1"/>
        <Peer address="172.30.11.42"/>
        <Peer address="172.27.80.139"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
