<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- gz_ros2_control system plugin: creates controller_manager inside Gazebo -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find mycobot_280pi_camera_moveit2)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Wrist camera sensor -->
  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="camera">
      <update_rate>30</update_rate>
      <topic>/wrist_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>RGB_INT8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>