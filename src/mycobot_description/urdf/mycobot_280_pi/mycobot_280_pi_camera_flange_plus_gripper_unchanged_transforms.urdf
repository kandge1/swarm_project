  </link>

  <link name="camera_flange">
    <inertial>
      <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
          <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                  iyy="0.0001" iyz="0.0"
                  izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/camera_flange.dae"/>
      </geometry>
    <origin xyz = "0.024 -0.008 0.0 " rpy = " 0 3.14159 0"/>
    </visual>
    <collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/camera_flange.dae"/>
      </geometry>
    <origin xyz = "0.024 -0.008 0.0 " rpy = " 0 3.14159 0"/>
    </collision>
  </link>

  <!-- Optical frame with ROS camera convention: z-forward, x-right, y-down -->
  <link name="wrist_camera_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0"
               izz="0.000001"/>
    </inertial>
  </link>
  <link name="wrist_camera_optical_frame">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="camera_flange_to_camera_link" type="fixed">
    <parent link="camera_flange"/>
    <child  link="wrist_camera_link"/>
    <!-- xyz measured from the physical camera body: lens is ~20mm along
         +X (lateral) and ~8.5mm along +Z (half the 16mm body thickness,
         plus 0.5mm safety margin) from the mounting-face origin. -->
    <origin xyz="0.0400 0.0085 0 " rpy="-1.5708 0 1.5708"/>
  </joint>

  <joint name="camera_link_to_optical" type="fixed">
    <parent link="wrist_camera_link"/>
    <child  link="wrist_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>


  <joint name="g_base_to_joint1" type="fixed">
    <axis xyz="0 0 0"/>
    <limit effort = "1000.0" lower = "-3.14" upper = "3.14159" velocity = "3.0"/>
    <parent link="g_base"/>
    <child link="joint1"/>
    <origin xyz= "0 0 0" rpy = "0 0 0"/>  
  </joint>


  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.9321" upper = "2.9321" velocity = "3.0"/>
    <parent link="joint1"/>
    <child link="joint2"/>
    <origin xyz= "0 0 0.13956" rpy = "0 0 0"/>  
  </joint>


  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.4434" upper = "2.4434" velocity = "3.0"/>
    <parent link="joint2"/>
    <child link="joint3"/>
    <origin xyz= "0 0 -0.001" rpy = "0 1.5708 -1.5708"/>  
  </joint>


  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort = "1000.0" lower = "-2.6179" upper = "2.6179" velocity = "3.0"/>
    <parent link="joint3"/>
    <child link="joint4"/>
    <origin xyz= "  -0.1104 0 0   " rpy = "0 0 0"/>  
  </joint>


  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort = "1000.0" lower = "-3.6179" upper = "3.6179" velocity = "3.0"/>
    <parent link="joint4"/>
    <child link="joint5"/>
    <origin xyz= "-0.096 0 0.06462" rpy = "0 0 -1.5708"/>  
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-2.7052" upper = "2.7925" velocity = "3.0"/>
    <parent link="joint5"/>
    <child link="joint6"/>
    <origin xyz= "0 -0.07318 -0.001" rpy = "1.5708 -1.5708 0"/>  
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-3.14159" upper = "3.14159" velocity = "3.0"/>
    <parent link="joint6"/>
    <child link="joint6_flange"/>
    <origin xyz= "0 0.0456 0" rpy = "-1.5708 0 0"/>  
  </joint>

  <joint name="joint6output_to_camera_flange" type="fixed">
    <!-- <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-3.14" upper = "3.14159" velocity = "3.0"/> -->
    <parent link="joint6_flange"/>
    <child link="camera_flange"/>
    <!-- <origin xyz= "0 0.0 0" rpy = "1.5708 1.5708 0"/>   -->
    <!-- yaw 1.5708 becomes 0.7854 (2026-07-28): the model was 45 deg out of
         roll about the tool axis against the physical mount.

         MEASURED, not guessed. With all six joints at zero the real arm has
         the camera lens facing +X (which the model already agreed with) and
         the camera body sitting 135 deg from +Y and 45 deg from +Z in the Y-Z
         plane, i.e. up and to the right at 45 deg, radial direction
         (0, -0.707, +0.707). Sweeping candidate yaw values through forward
         kinematics (swarm_pkg scripts/tool_frame_check.py) against that
         observation gave:

             yaw 1.5708 (was)   gives (0, -1.000,  0.000)    45.0 deg off
             yaw 0.7854 (now)   gives (0, -0.707, +0.707)     0.5 deg off
             yaw 2.3562         gives (0, -0.707, -0.707)    90.0 deg off
             yaw 4.7124         gives (0, +1.000,  0.000)   135.0 deg off

         The residual 0.5 deg is this file's own 1.579 roll term, not error.

         This is the 45 deg that HOME_DEGREES joint6output = -45 has been
         compensating for. That compensation STAYS: it is what brings the real
         assembly from its 45 deg rest offset round to horizontal. With this
         fix RViz finally shows what the arm is actually doing, at zero and at
         home alike.

         joint6_flange is the PARENT here and does not move, so IK, the grasp
         quaternion and Cartesian planning are untouched. What changes is where
         the model believes the camera and gripper are, which is the point, and
         which means collision geometry and any camera frame work were
         previously 45 deg wrong. -->
    <origin xyz= "0 0 0.01" rpy = "1.579 0 0.7854"/>
  </joint>

  <!-- Adaptive gripper copied without changing any xyz or rpy values. -->
<joint name="camera_flange_to_gripper_base" type="fixed">
    <!-- <axis xyz="0 0 1"/>
    <limit effort = "1000.0" lower = "-3.14" upper = "3.14159" velocity = "3.0"/> -->
    <parent link="camera_flange"/>
    <child link="gripper_base"/>
    <!-- <origin xyz= "0 0.0 0" rpy = "0 1.5708 1.5708"/>   -->
    <origin xyz= "0 0.04 0" rpy = "0.0082 -1.5708 0"/>  
  </joint>

  <link name="gripper_base">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0"
               iyy="0.00005" iyz="0.0"
               izz="0.00005"/>
    </inertial>
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_base.dae"/>
      </geometry>
    <origin xyz = "0.0 0 -0.012 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_base.dae"/>
      </geometry>
    <origin xyz = "0.0 0 -0.012 " rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="gripper_left1">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left1.dae"/>
      </geometry>
    <origin xyz = "0.039 -0.0133 -0.012 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <!-- Box, not the mesh, for collision: gz-sim/DART requires convex
           collision geometry for dynamic (moving, non-static) bodies, so a
           mesh collision here gets silently replaced with a single convex
           hull of the whole mesh. On a finger link that hull fills in any
           concave curvature of the contact surface, bulging the true
           collision boundary out past the visual mesh, which is why the
           gripper was reported registering contact well before the fingers
           visually touched the block. This box is a tight axis-aligned
           bound of gripper_left1.dae's true composed geometry, computed
           with trimesh (which walks the COLLADA node/matrix hierarchy
           and applies unit-meter=0.001), NOT by reading the raw vertex
           source arrays directly. An earlier attempt did the latter, which
           ignores each geometry node's own transform and produced a bogus,
           badly-mispositioned box: the fingers passed straight through
           the block with no collision response at all. Verify visually
           (RViz "Show Collision Geometry") before trusting this further if
           the mesh is ever re-exported. -->
      <geometry>
        <box size="0.0244 0.0582 0.0207"/>
      </geometry>
        <origin xyz = "0.0065 0.0241 -0.0082" rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="gripper_left2">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left2.dae"/>
      </geometry>
    <origin xyz = "0.005 -0.0195 -0.012 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <!-- Box, not mesh: see gripper_left1's collision comment above for why. -->
      <geometry>
        <box size="0.0359 0.0243 0.0200"/>
      </geometry>
        <origin xyz = "-0.0145 0.0075 -0.0082" rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="gripper_left3">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left3.dae"/>
      </geometry>
    <origin xyz = "0.012 0.0025 -0.012 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <!-- Box, not mesh: see gripper_left1's collision comment above for why. -->
      <geometry>
        <box size="0.0450 0.0335 0.0050"/>
      </geometry>
    <origin xyz = "-0.0097 0.0025 -0.0007" rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="gripper_right1">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
