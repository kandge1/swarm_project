    <origin xyz = "-0.039 -0.0133 -0.012 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <!-- Box, not mesh: see gripper_left1's collision comment above for why. -->
      <geometry>
        <box size="0.0244 0.0582 0.0207"/>
      </geometry>
        <origin xyz = "-0.0078 0.0245 -0.0082" rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="gripper_right2">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
       <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right2.dae"/>
