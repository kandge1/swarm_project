      </geometry>
      <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
    </collision>
    <inertial>
      <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

