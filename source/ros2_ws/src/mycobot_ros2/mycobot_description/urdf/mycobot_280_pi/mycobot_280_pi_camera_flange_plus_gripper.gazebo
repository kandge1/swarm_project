<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="wrist_camera_link">
    <sensor type="camera" name="wrist_camera">
      <update_rate>30.0</update_rate>
      <camera name="wrist_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <camera_name>wrist_camera</camera_name>
        <frame_name>wrist_camera_optical_frame</frame_name>
        <ros><remapping>image_raw:=/wrist_camera/image_raw</remapping></ros>
      </plugin>
    </sensor>
  </gazebo>

</robot>
